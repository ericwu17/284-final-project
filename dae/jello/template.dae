          <float_array id="backWall-mesh-positions-array" count="12">1.33333 1.5 -1 1.33333 0 -1 -1.33333 0 -1 -1.33333 1.5 -1</float_array>
          <technique_common>
            <accessor source="#backWall-mesh-positions-array" count="4" stride="3">
