            </index_of_refraction>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
    <!-- Jello: diffuse placeholder until Stage R2 adds the CGL <jello> profile. -->
    <effect id="jello-effect">
      <profile_COMMON>
        <technique sid="common">
          <phong>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <ambient>
              <color sid="ambient">0 0 0 1</color>
            </ambient>
            <diffuse>
              <color sid="diffuse">0.8 0.35 0.15 1</color>
            </diffuse>
            <specular>
              <color sid="specular">0 0 0 1</color>
            </specular>
            <shininess>
              <float sid="shininess">1</float>
            </shininess>
            <index_of_refraction>
              <float sid="index_of_refraction">1</float>
            </index_of_refraction>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
    <effect id="plate-effect">
      <profile_COMMON>
        <technique sid="common">
          <phong>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <ambient>
              <color sid="ambient">0 0 0 1</color>
            </ambient>
            <diffuse>
              <color sid="diffuse">0.35 0.4 0.5 1</color>
            </diffuse>
            <specular>
              <color sid="specular">0 0 0 1</color>
            </specular>
            <shininess>
              <float sid="shininess">1</float>
            </shininess>
            <index_of_refraction>
              <float sid="index_of_refraction">1</float>
            </index_of_refraction>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
  </library_effects>
  <library_materials>
    <material id="ceiling-material" name="ceiling">
      <instance_effect url="#ceiling-effect"/>
    </material>
    <material id="light-material" name="light">
      <instance_effect url="#light-effect"/>
    </material>
    <material id="floor-material" name="floor">
