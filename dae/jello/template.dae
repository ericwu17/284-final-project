<?xml version="1.0" encoding="utf-8"?>
<!-- Jello studio template (Stage P3): dae/sky/CBempty.dae plus a jello mesh and a
     plate, filled in per frame by `jellosim --run SCENE --export DIR`.
     Placeholders (in double braces below): JELLO_FLOAT_COUNT, JELLO_POS_COUNT,
     JELLO_POSITIONS, JELLO_TRI_COUNT, JELLO_VCOUNT, JELLO_INDICES, PLATE_MATRIX. -->
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
  <asset>
    <contributor>
      <author>Blender User</author>
      <authoring_tool>Blender 2.74.0 commit date:2015-03-31, commit time:13:39, hash:000dfc0</authoring_tool>
    </contributor>
    <created>2015-10-20T15:59:57</created>
    <modified>2015-10-20T15:59:57</modified>
    <unit name="meter" meter="1"/>
    <up_axis>Z_UP</up_axis>
  </asset>
  <!-- Camera: the path tracer ignores the camera's position and aims at the
       center of the scene's bounding box (the box) from a fixed direction. Its
       field of view is applied at the 800x600 startup window and then scaled
       with the output size, so xfov = 27.5 frames the box edge to edge only at
       -r 960 540 (smaller outputs zoom in, larger ones zoom out). -->
  <library_cameras>
    <camera id="Camera-camera" name="Camera">
      <optics>
        <technique_common>
          <perspective>
            <xfov sid="xfov">27.5</xfov>
            <aspect_ratio>1.777778</aspect_ratio>
            <znear sid="znear">0.1</znear>
            <zfar sid="zfar">100</zfar>
          </perspective>
        </technique_common>
      </optics>
    </camera>
  </library_cameras>
  <library_lights>
    <!-- Light as in CBspheres_lambertian.dae: the CGL-profile <area> wins over the
         common <point>. (CBempty has only a 5 W point light under the ceiling,
         which blows out the walls.) -->
    <light id="Area-light" name="Light">
      <technique_common>
        <point>
          <color sid="color">10 10 10</color>
          <constant_attenuation>1</constant_attenuation>
          <linear_attenuation>0</linear_attenuation>
          <quadratic_attenuation>0.001599967</quadratic_attenuation>
        </point>
      </technique_common>
      <extra>
        <technique profile="CGL">
          <area>
            <color sid="color">10 10 10</color>
          </area>
        </technique>
      </extra>
    </light>
  </library_lights>
  <library_images/>
  <library_effects>
    <effect id="ceiling-effect">
      <profile_COMMON>
        <technique sid="common">
          <phong>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <ambient>
              <color sid="ambient">0 0 0 1</color>
            </ambient>
            <diffuse>
              <color sid="diffuse">0.6 0.6 0.6 1</color>
            </diffuse>
            <specular>
              <color sid="specular">0 0 0 1</color>
            </specular>
            <shininess>
              <float sid="shininess">1</float>
            </shininess>
            <index_of_refraction>
              <float sid="index_of_refraction">1</float>
            </index_of_refraction>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
    <effect id="light-effect">
      <profile_COMMON>
        <technique sid="common">
          <phong>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <ambient>
              <color sid="ambient">0 0 0 1</color>
            </ambient>
            <diffuse>
              <color sid="diffuse">0.8 0.8 0.8 1</color>
            </diffuse>
            <specular>
              <color sid="specular">0 0 0 1</color>
            </specular>
            <shininess>
              <float sid="shininess">1</float>
            </shininess>
            <index_of_refraction>
              <float sid="index_of_refraction">1</float>
            </index_of_refraction>
          </phong>
        </technique>
      </profile_COMMON>
      <extra>
        <technique profile="CGL">
          <emission>
            <radiance>10 10 10</radiance>
          </emission>
        </technique>
      </extra>
    </effect>
    <effect id="floor-effect">
      <profile_COMMON>
        <technique sid="common">
          <phong>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <ambient>
              <color sid="ambient">0 0 0 1</color>
            </ambient>
            <diffuse>
              <color sid="diffuse">0.6 0.6 0.6 1</color>
            </diffuse>
            <specular>
              <color sid="specular">0 0 0 1</color>
            </specular>
            <shininess>
              <float sid="shininess">1</float>
            </shininess>
            <index_of_refraction>
