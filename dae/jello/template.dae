            </emission>
            <ambient>
              <color sid="ambient">0 0 0 1</color>
            </ambient>
            <diffuse>
              <color sid="diffuse">0.6 0.2 0.2 1</color>
            </diffuse>
            <specular>
              <color sid="specular">0 0 0 1</color>
            </specular>
            <shininess>
