            <ambient>
              <color sid="ambient">0 0 0 1</color>
            </ambient>
            <diffuse>
              <color sid="diffuse">0.2 0.2 0.6 1</color>
            </diffuse>
            <specular>
              <color sid="specular">0 0 0 1</color>
            </specular>
            <shininess>
              <float sid="shininess">1</float>
